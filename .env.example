# API
API_HOST=127.0.0.1
API_PORT=8788
OPS_TOKEN=crave-local-ops
OPS_ALLOW_REMOTE=0
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# Web
WEB_PORT=4173

# Production (Vercel): OPS_TOKEN is REQUIRED — no demo default on Vercel.
# Generate a long random string and set it in the Vercel project env.

# Payments (owner Stripe account for food checkout — optional until wired)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PUBLIC_APP_URL=https://crave-it-create-it.vercel.app

# Future production providers
# DATABASE_URL=
# SESSION_SECRET=
# TWILIO_ACCOUNT_SID=
# MAPS_API_KEY=

Local demo: operator board uses x-ops-token (default crave-local-ops).
API binds 127.0.0.1 by default.

{
  "name": "crave-it-create-it",
  "version": "0.3.0",
  "private": true,
  "description": "Mobile kitchen fleet platform: live per-truck inventory, ordering, Concept Lab, and demo ops.",
  "workspaces": [
    "apps/mobile",
    "packages/contracts"
  ],
  "scripts": {
    "start": "node scripts/prod-server.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "node apps/web/server.mjs",
    "dev:api": "node services/api/server.mjs",
    "check": "node scripts/check.mjs",
    "test": "node scripts/test.mjs",
    "build": "node scripts/check.mjs",
    "mobile": "npm --workspace apps/mobile run start"
  },
  "engines": {
    "node": ">=20"
  }
}
